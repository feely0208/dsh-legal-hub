{
  "name": "@deepwhale-cn/dsh-legal-hub",
  "version": "0.1.1",
  "description": "深鲸法律台：一个面板集中打开合同体检、引用核验、合规文书、中文排版，并直达法律技能库与文书脱敏 App。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "legal",
    "法律",
    "hub",
    "panel"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0",
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "author": "温州深鲸智能科技有限公司 <contact@deepwhale.org.cn>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-legal-hub.git"
  },
  "homepage": "https://www.deepwhale.org.cn/legal.html",
  "bugs": {
    "url": "https://github.com/feely0208/dsh-legal-hub/issues"
  }
}
